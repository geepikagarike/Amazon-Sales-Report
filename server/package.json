{
  "name": "ecommerce-data-analytics-server",
  "version": "2.0.0",
  "description": "Enterprise E-Commerce Order Tracker & Analytics API using Node.js, Express, MongoDB Atlas, Excel, Power BI and Tableau Integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:live": "node scripts/live_api_smoke.js",
    "import-orders": "node scripts/importOrders.js",
    "import-orders:dry-run": "node scripts/importOrders.js --dry-run",
    "import-data": "node ../mongodb/import_data.js",
    "create-indexes": "node ../mongodb/create_indexes.js",
    "run-queries": "node ../mongodb/query_runner.js"
  },
  "keywords": [
    "ecommerce",
    "analytics",
    "mongodb",
    "express",
    "powerbi",
    "tableau",
    "excel",
    "data-analytics"
  ],
  "author": "Garik",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongodb": "^6.8.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
